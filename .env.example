CONFIG_PATH=config/commerce.yml
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=agentic_commerce
SOURCE_ROOTS=["vendor_databases"]
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
ADMIN_API_KEY=
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
MODEL_API_BASE=
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay TEST Mode only. Never commit live keys or put the secret in frontend code.
# RAZORPAY_KEY_ID is the public Checkout identifier. RAZORPAY_KEY_SECRET stays server-side.
# CommerceOS loads this file at startup. Do not export it into the shell.
# MODEL_API_KEY is the application secret and is passed to AnyLLM.create.
# Leave MODEL_* blank for deterministic home → search chat.
#
# Example Gemini:
# MODEL_PROVIDER=gemini
# MODEL_NAME=gemini-3.6-flash
# MODEL_API_KEY=
#
# Example Groq:
# MODEL_PROVIDER=groq
# MODEL_NAME=openai/gpt-oss-120b
# MODEL_API_KEY=
#
# Optional: MODEL_API_BASE for a compatible custom endpoint.
# AnyLLM may also read a provider-native name from the process (for example
# GEMINI_API_KEY) after `.env` is loaded. Prefer MODEL_API_KEY so every
# provider uses the same CommerceOS setting.
